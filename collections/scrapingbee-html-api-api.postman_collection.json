{
  "item": [
    {
      "id": "6940a977-e884-457d-80cc-63a4d0884061",
      "name": "HTML API",
      "description": {
        "content": "Headless-browser scraping with proxy rotation, screenshots, and AI extraction.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "d8d49aac-0754-41d3-aac8-b27fb1149f0a",
          "name": "Scrape a URL and Return HTML, Screenshot, or JSON",
          "request": {
            "name": "Scrape a URL and Return HTML, Screenshot, or JSON",
            "description": {
              "content": "Fetch a target URL through ScrapingBee's headless browser and proxy network.\nReturns rendered HTML by default, or a screenshot/JSON wrapper/markdown/text\ndepending on the parameters supplied.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) ScrapingBee account key."
                },
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<uri>",
                  "description": "(Required) URL to scrape (must be URL-encoded, include scheme)."
                },
                {
                  "disabled": false,
                  "key": "render_js",
                  "value": "true",
                  "description": "Execute JavaScript via headless browser. Defaults to true (5 credits)."
                },
                {
                  "disabled": false,
                  "key": "js_scenario",
                  "value": "<string>",
                  "description": "JSON-encoded scenario describing browser interactions (clicks, fills, scrolls, waits)."
                },
                {
                  "disabled": false,
                  "key": "wait",
                  "value": "<integer>",
                  "description": "Additional rendering delay in milliseconds."
                },
                {
                  "disabled": false,
                  "key": "wait_for",
                  "value": "<string>",
                  "description": "CSS or XPath selector to wait for before returning."
                },
                {
                  "disabled": false,
                  "key": "wait_browser",
                  "value": "<string>",
                  "description": "Browser state condition to wait for."
                },
                {
                  "disabled": false,
                  "key": "premium_proxy",
                  "value": "<boolean>",
                  "description": "Use residential premium proxy pool (10 credits without JS, 25 with JS)."
                },
                {
                  "disabled": false,
                  "key": "stealth_proxy",
                  "value": "<boolean>",
                  "description": "Use the stealth proxy pool for high-protection sites (75 credits)."
                },
                {
                  "disabled": false,
                  "key": "country_code",
                  "value": "<string>",
                  "description": "ISO 3166-1 country code for proxy geolocation."
                },
                {
                  "disabled": false,
                  "key": "block_ads",
                  "value": "<boolean>",
                  "description": "Block advertisements during rendering."
                },
                {
                  "disabled": false,
                  "key": "block_resources",
                  "value": "<boolean>",
                  "description": "Block heavy resources (images, fonts, css) to speed up rendering."
                },
                {
                  "disabled": false,
                  "key": "cookies",
                  "value": "<string>",
                  "description": "Semicolon-separated cookie list to send with the request."
                },
                {
                  "disabled": false,
                  "key": "forward_headers",
                  "value": "<boolean>",
                  "description": "Forward Spb-* prefixed headers to the target site."
                },
                {
                  "disabled": false,
                  "key": "screenshot",
                  "value": "<boolean>",
                  "description": "Return a screenshot of the page instead of HTML."
                },
                {
                  "disabled": false,
                  "key": "screenshot_full_page",
                  "value": "<boolean>",
                  "description": "Capture a full-page screenshot, not just the viewport."
                },
                {
                  "disabled": false,
                  "key": "screenshot_selector",
                  "value": "<string>",
                  "description": "CSS selector to limit the screenshot region."
                },
                {
                  "disabled": false,
                  "key": "json_response",
                  "value": "<boolean>",
                  "description": "Wrap response in JSON format with metadata."
                },
                {
                  "disabled": false,
                  "key": "return_page_text",
                  "value": "<boolean>",
                  "description": "Return plain text content instead of HTML."
                },
                {
                  "disabled": false,
                  "key": "return_page_markdown",
                  "value": "<boolean>",
                  "description": "Return content as Markdown."
                },
                {
                  "disabled": false,
                  "key": "return_page_source",
                  "value": "<boolean>",
                  "description": "Return the pre-JavaScript HTML source."
                },
                {
                  "disabled": false,
                  "key": "extract_rules",
                  "value": "<string>",
                  "description": "JSON-encoded extraction rules (CSS or XPath selectors)."
                },
                {
                  "disabled": false,
                  "key": "ai_query",
                  "value": "<string>",
                  "description": "Natural-language instruction for AI-powered data extraction."
                },
                {
                  "disabled": false,
                  "key": "ai_extract_rules",
                  "value": "<string>",
                  "description": "JSON-encoded AI extraction rules mapping field names to natural-language descriptions."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "method": "GET",
            "auth": null
          },
