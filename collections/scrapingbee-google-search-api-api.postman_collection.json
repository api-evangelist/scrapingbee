  "item": [
    {
      "id": "4ec8668f-4e63-455e-8d11-834e3b6352e8",
      "name": "Google Search API",
      "description": {
        "content": "Structured Google SERP results (web, news, maps, images).",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "5b1ac347-43aa-4d8e-ac85-2bd1e3409668",
          "name": "Run a Google Search and Return Structured SERP JSON",
          "request": {
            "name": "Run a Google Search and Return Structured SERP JSON",
            "description": {
              "content": "Execute a Google query via ScrapingBee's dedicated Search API and receive\nstructured JSON results: organic listings, knowledge graph, featured\nsnippets, news, maps, image results, related searches, and ads.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "google"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) ScrapingBee account key."
                },
                {
                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "(Required) Query string as typed into the Google search bar."
                },
                {
                  "disabled": false,
                  "key": "search_type",
                  "value": "classic",
                  "description": "Which Google vertical to query."
                },
                {
                  "disabled": false,
                  "key": "country_code",
                  "value": "<string>",
                  "description": "ISO 3166-1 alpha-2 country code for result localization."
                },
                {
                  "disabled": false,
                  "key": "language",
                  "value": "<string>",
                  "description": "Result language (hl parameter equivalent)."
                },
                {
                  "disabled": false,
                  "key": "nb_results",
                  "value": "10",
                  "description": "Number of results to return."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Result page number."
                },
                {
                  "disabled": false,
                  "key": "device",
                  "value": "desktop",
                  "description": "Render Google as desktop or mobile."
                },
                {
                  "disabled": false,
                  "key": "extra_params",
                  "value": "<string>",
                  "description": "Additional Google query parameters (gl, hl, num, start, etc.)."
                },
                {
                  "disabled": false,
                  "key": "light_request",
                  "value": "<boolean>",
                  "description": "Use the cheaper, faster light request mode."
                },
                {
                  "disabled": false,
                  "key": "full_html",
                  "value": "<boolean>",
                  "description": "Return the full SERP HTML alongside the structured payload."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
