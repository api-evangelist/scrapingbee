      "item": [
        {
          "name": "Run a Google Search and Return Structured SERP JSON",
          "id": "3b98258a-626e-42a7-bbac-d18fe45ca739",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/google?api_key=<string>&search=<string>&search_type=classic&country_code=<string>&language=<string>&nb_results=10&page=1&device=desktop&extra_params=<string>&light_request=<boolean>&full_html=<boolean>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "google"
              ],
              "query": [
                {
                  "description": "(Required) ScrapingBee account key.",
                  "key": "api_key",
                  "value": "<string>"
                },
                {
                  "description": "(Required) Query string as typed into the Google search bar.",
                  "key": "search",
                  "value": "<string>"
                },
                {
                  "description": "Which Google vertical to query.",
                  "key": "search_type",
                  "value": "classic"
                },
                {
                  "description": "ISO 3166-1 alpha-2 country code for result localization.",
                  "key": "country_code",
                  "value": "<string>"
                },
                {
                  "description": "Result language (hl parameter equivalent).",
                  "key": "language",
                  "value": "<string>"
                },
                {
                  "description": "Number of results to return.",
                  "key": "nb_results",
                  "value": "10"
                },
                {
                  "description": "Result page number.",
                  "key": "page",
                  "value": "1"
                },
                {
                  "description": "Render Google as desktop or mobile.",
                  "key": "device",
                  "value": "desktop"
                },
                {
                  "description": "Additional Google query parameters (gl, hl, num, start, etc.).",
                  "key": "extra_params",
                  "value": "<string>"
                },
                {
                  "description": "Use the cheaper, faster light request mode.",
                  "key": "light_request",
                  "value": "<boolean>"
                },
                {
                  "description": "Return the full SERP HTML alongside the structured payload.",
                  "key": "full_html",
                  "value": "<boolean>"
                }
              ]
            },
            "description": "Execute a Google query via ScrapingBee's dedicated Search API and receive\nstructured JSON results: organic listings, knowledge graph, featured\nsnippets, news, maps, image results, related searches, and ads.\n"
          },
